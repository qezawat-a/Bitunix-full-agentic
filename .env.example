# Required
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# LLM provider (optional — can be set later in Settings; AutoSetModelByKey discovers working models)
AGENT_PROVIDER=            # openai | anthropic | gemini
AGENT_BASE_URL=            # e.g. https://api.openai.com/v1  (any OpenAI-compatible base works)
AGENT_API_KEY=
AGENT_MODEL=

# Bitunix futures (optional — enables LIVE trading mode; SIM works without keys)
BITUNIX_API_KEY=
BITUNIX_SECRET_KEY=

# GitHub push (optional — classic PAT with `repo` scope)
GITHUB_TOKEN=
GITHUB_REPO=               # owner/repo

# Protects the cron tick endpoint in production
CRON_SECRET=
